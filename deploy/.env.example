# Copy to .env and fill in.

# Public name of the server (its DNS record must point to this machine).
DOMAIN=note.azienda.it

# Image published by the Release workflow: ghcr.io/<github owner>/<repository>-server (lowercase).
TEAM_SYNC_IMAGE=ghcr.io/owner/repo-server
# A released version (e.g. 0.2.0), or "latest".
TEAM_SYNC_VERSION=latest

LOCK_TTL_SECONDS=90
MAX_FILE_MB=100
